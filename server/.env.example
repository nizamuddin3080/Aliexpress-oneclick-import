# Server Configuration
PORT=3456
NODE_ENV=development
BACKEND_URL=http://localhost:3456

# Shopify App Credentials (from Shopify Dev Dashboard)
# Create a Custom App in Dev Dashboard to obtain these credentials.
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here

# Cryptographic Keys (generate with: openssl rand -hex 32)
JWT_SECRET=your_32_byte_hex_jwt_secret_here
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# SQLite Database Persistence
DATABASE_PATH=./data/importer.db

# Shopify API Version & Scope
SHOPIFY_API_VERSION=2026-01
SHOPIFY_SCOPES=write_products

# Pinned Chrome Extension ID for CORS and OAuth redirect target
# Development: Unpacked extension ID from chrome://extensions
# Production: Web Store published extension ID
EXTENSION_ID=your_chrome_extension_id_here
